{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "DevDoctor",
        "width": 1320,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Visible"
      }
    ]
  },
  "bundle": {
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
